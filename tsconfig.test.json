{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "nodenext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["src/*.test.ts","src/**/*.test.ts", "test/**/*.ts"],
  "exclude": ["lib", "node_modules"]
}